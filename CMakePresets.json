{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "PATH": "$env{MINGW_ROOT}/bin;${sourceDir}/.tools/cmake-4.5.1-windows-x86_64/bin;${sourceDir}/.tools;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{MINGW_ROOT}/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MINGW_ROOT}/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja.exe",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "MinGW GCC + vcpkg x64-mingw-dynamic (Debug)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "MinGW GCC + vcpkg x64-mingw-dynamic (Release)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "sandbox",
      "inherits": "release",
      "displayName": "Sandboxed build: workspace-local vcpkg clone (.vcpkg)",
      "binaryDir": "${sourceDir}/build/sandbox",
      "toolchainFile": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_DEFAULT_BINARY_CACHE": "${sourceDir}/build/vcpkg-binary-cache",
        "TMP": "${sourceDir}/build/tmp",
        "TEMP": "${sourceDir}/build/tmp"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_WORKS": "TRUE",
        "CMAKE_CXX_ABI_COMPILED": "TRUE"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sandbox", "configurePreset": "sandbox" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "sandbox", "configurePreset": "sandbox", "output": { "outputOnFailure": true } }
  ]
}
