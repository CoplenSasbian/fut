# fut CMake helpers.
#
# add_app(<name> <prefix> [sources...])
#
# Creates one business app DLL: target fut_app_<name>, artifact
# fut_app_<name>.dll in <binary>/bin/apps (next to the server executable),
# with the standard include path and link set.
#
#     add_app(admin /api/admin admin_app.hpp)
#         -> target fut_app_admin, DLL fut_app_admin.dll
#
# Code injection: the DLL's export unit is GENERATED (fut_export_<name>.cpp
# in the build tree, written by file(WRITE) at configure time):
#
#     // Generated by fut's add_app(); do not edit.
#     #include <fut/refl_router.hpp>
#     #include "<first source>"
#     FUT_EXPORT_APP_NS(FUT_APP_NAME, FUT_APP_PREFIX, ^^fut_actions)
#
# The FIRST source is therefore "the app header": it declares the actions as
# free functions inside 'namespace fut_actions'; the annotations are the
# routes. The export unit scans that namespace with std::meta reflection, so
# no action list is ever written by hand.
#
# The name and prefix live in exactly one place -- the add_app() call. The
# generated unit consumes them through the FUT_APP_NAME / FUT_APP_PREFIX
# compile definitions, so the C++ side can never drift out of sync.
#
# Conventions enforced here:
#   * the prefix must be an absolute path segment and not end in '/' --
#     a malformed prefix would silently never match;
#   * MODULE targets are governed by LIBRARY_OUTPUT_DIRECTORY (Windows DLLs
#     included -- RUNTIME_OUTPUT_DIRECTORY alone is ignored for them);
#   * apps that prefer to hand-write FUT_EXPORT_APP can still use the
#     FUT_APP_NAME / FUT_APP_PREFIX literals themselves.
#
# Every created app is recorded in the global property FUT_APPS as one
# "<target>:<prefix>" entry for summaries and tooling. (A ';' would split the
# CMake list and double the entry count.)

function(add_app name prefix)
    if(NOT prefix MATCHES "^/")
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): the app prefix must start with '/' (e.g. '/api/admin')")
    endif()
    if(prefix MATCHES "/$")
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): the app prefix must not end with '/'")
    endif()
    if(ARGC LESS 3)
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): at least one source file is required")
    endif()

    set(target fut_app_${name})
    add_library(${target} MODULE ${ARGN})

    set_target_properties(${target} PROPERTIES
        PREFIX ""
        OUTPUT_NAME "${target}"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/apps"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/apps"
    )

    target_include_directories(${target} PRIVATE
        ${PROJECT_SOURCE_DIR}/include
        ${CMAKE_CURRENT_SOURCE_DIR})

    target_link_libraries(${target} PRIVATE Boost::asio glaze::glaze)
    target_compile_definitions(${target} PRIVATE
        FUT_APP_NAME="${name}"
        FUT_APP_PREFIX="${prefix}"
    )

    # ---- injected export unit ------------------------------------------
    # The generated TU includes the app header and scans its 'fut_actions'
    # namespace for annotated functions. Everything the app author writes
    # is actions; everything boilerplate is here.
    list(GET ARGN 0 app_header)
    set(gen "${CMAKE_CURRENT_BINARY_DIR}/fut_export_${name}.cpp")
    file(WRITE "${gen}"
"// Generated by fut's add_app(); do not edit.
#include <fut/refl_router.hpp>

#include \"${app_header}\"

FUT_EXPORT_APP_NS(FUT_APP_NAME, FUT_APP_PREFIX, ^^fut_actions)
")
    target_sources(${target} PRIVATE "${gen}")

    set_property(GLOBAL APPEND PROPERTY FUT_APPS "${target}:${prefix}")

    message(STATUS "add_app: ${target} at ${prefix} (export unit generated: ${gen})")
endfunction()

# Prints how many business apps were registered. Call after every
# add_subdirectory that uses add_app(); reads the global FUT_APPS property.
function(fut_app_summary)
    get_property(apps GLOBAL PROPERTY FUT_APPS)
    if(apps)
        list(LENGTH apps count)
        message(STATUS "fut: ${count} business app(s) registered: ${apps}")
    else()
        message(STATUS "fut: no business apps registered")
    endif()
endfunction()
