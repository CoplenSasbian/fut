# fut CMake helpers.
#
# add_app(<name> <prefix> [sources...])
#
# Creates one business app DLL: target fut_app_<name>, artifact
# fut_app_<name>.dll in <binary>/bin/apps (next to the server executable),
# with the standard include path and link set.
#
#     add_app(admin /api/admin admin_app.hpp)
#         -> target fut_app_admin, DLL fut_app_admin.dll
#
# Code injection: the DLL's export unit is GENERATED (fut_export_<name>.cpp
# in the build tree, written by file(WRITE) at configure time):
#
#     // Generated by fut's add_app(); do not edit.
#     #include <fut/http/http.hpp>
#     #include <header 1>            <- every listed HEADER, in order
#     #include <header 2>
#     FUT_EXPORT_APP_NS(FUT_APP_NAME, FUT_APP_PREFIX, ^^<name>)
#
# FUT_EXPORT_APP_NS emits the DLL's only entry point:
#
#     extern "C" void fut_app_register(fut::fut_ctx* ctx) {
#         fut::scan::run<^^<name>>(ctx, FUT_APP_PREFIX);
#     }
#
# The prefix from add_app() reaches every route as the FUT_APP_PREFIX
# compile definition, so the DLL composes its own paths and the executable
# never learns the prefix at build time. The scanner hands each
# controller-annotated class to that annotation's operation(), which calls
# router_module::add_route() -- obtained from the context, not linked.
#
# The generated unit is the ONLY place scanning code exists. Sources split
# by extension:
#   * headers (.hpp/.h) are #include'd into the generated unit, so the scan
#     sees the annotated DECLARATIONS. That is the recommended app layout:
#     annotated declarations in the header, plain definitions in .cpp files,
#     which are compiled as ordinary translation units and linked into the
#     DLL. Reflection works on declarations: no definition has to be visible
#     to the scanner, and the generated calls resolve through the linker.
#     A header included from anywhere else (other .cpp files, other targets)
#     never scans anything -- there is no scanning code there, so no
#     duplicate routes and no duplicate symbols are possible.
#   * sources (.cpp/.cxx) are compiled normally as definition units.
#
# Header-only apps work too: list just the header(s) and define the actions
# inline there (the generated unit includes them, one scan, one definition).
#
# The app's actions live in 'namespace <name>' -- the namespace named after
# the app; the scan descends into nested namespaces recursively, so actions
# can be grouped freely and no action list is ever written by hand.
#
# The name and prefix live in exactly one place -- the add_app() call. The
# generated unit consumes them through the FUT_APP_NAME / FUT_APP_PREFIX
# compile definitions, so the C++ side can never drift out of sync: the
# prefix is what the controller registration composes into every route.
#
# Conventions enforced here:
#   * the prefix must be an absolute path segment and not end in '/' --
#     a malformed prefix would silently never match;
#   * MODULE targets are governed by LIBRARY_OUTPUT_DIRECTORY (Windows DLLs
#     included -- RUNTIME_OUTPUT_DIRECTORY alone is ignored for them);
#   * apps that prefer to hand-write FUT_EXPORT_APP can still use the
#     FUT_APP_NAME / FUT_APP_PREFIX literals themselves.
#
# Every created app is recorded in the global property FUT_APPS as one
# "<target>:<prefix>" entry for summaries and tooling. (A ';' would split the
# CMake list and double the entry count.)

function(add_app name prefix)
    if(NOT prefix MATCHES "^/")
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): the app prefix must start with '/' (e.g. '/api/admin')")
    endif()
    if(prefix MATCHES "/$")
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): the app prefix must not end with '/'")
    endif()
    if(ARGC LESS 3)
        message(FATAL_ERROR
            "add_app(${name}, '${prefix}'): at least one source file is required")
    endif()

    set(target fut_app_${name})
    add_library(${target} MODULE ${ARGN})

    set_target_properties(${target} PROPERTIES
        PREFIX ""
        OUTPUT_NAME "${target}"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/apps"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/apps"
    )

    target_include_directories(${target} PRIVATE
        ${PROJECT_SOURCE_DIR}/include
        ${CMAKE_CURRENT_SOURCE_DIR})

    target_link_libraries(${target} PRIVATE Boost::asio glaze::glaze)
    target_compile_definitions(${target} PRIVATE
        FUT_APP_NAME="${name}"
        FUT_APP_PREFIX="${prefix}"
    )

    # ---- injected export unit ------------------------------------------
    # Exactly one scanning translation unit: the generated unit includes the
    # app headers (annotated declarations) and scans them; listed .cpp files
    # are ordinary definition units linked into the same DLL. Headers
    # included from other files or targets never scan anything.
    set(gen_includes "")
    set(saw_header FALSE)
    foreach(src IN LISTS ARGN)
        if(src MATCHES "\.(cpp|cxx|cc)$")
            # A definition unit: compiled normally, linked into the DLL.
            # Annotations must live on the declarations in the scanned
            # headers -- an annotation hidden in a definition TU would be
            # invisible to the scan (silent missing route), so refuse it
            # at configure time instead.
            file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${src}" cpp_content)
            if(cpp_content MATCHES "=fut::http_")
                message(FATAL_ERROR
                    "add_app(${name}): ${src} contains route annotations"
                    " ([[=fut::http_*]). The generated unit scans only the"
                    " listed HEADERS, so an annotation in a .cpp is invisible"
                    " to the scan and its route would be missing silently."
                    " Put the annotated declaration in the app header"
                    " instead; the definition stays here without attributes.")
            endif()
        else()
            set(saw_header TRUE)
            string(APPEND gen_includes "#include <${src}>
")
        endif()
    endforeach()
    if(NOT saw_header)
        message(FATAL_ERROR
            "add_app(${name}): at least one header is required -- the generated unit"
            " scans the annotated declarations from headers; .cpp files are compiled"
            " as ordinary definition units.")
    endif()
    set(gen "${CMAKE_CURRENT_BINARY_DIR}/fut_export_${name}.cpp")
    file(WRITE "${gen}"
"// Generated by fut's add_app(); do not edit.
#include <fut/http/http.hpp>

${gen_includes}
FUT_EXPORT_APP_NS(FUT_APP_NAME, FUT_APP_PREFIX, ^^${name})
")
    target_sources(${target} PRIVATE "${gen}")

    set_property(GLOBAL APPEND PROPERTY FUT_APPS "${target}:${prefix}")

    message(STATUS "add_app: ${target} at ${prefix} (export unit generated: ${gen})")
endfunction()

# Prints how many business apps were registered. Call after every
# add_subdirectory that uses add_app(); reads the global FUT_APPS property.
function(fut_app_summary)
    get_property(apps GLOBAL PROPERTY FUT_APPS)
    if(apps)
        list(LENGTH apps count)
        message(STATUS "fut: ${count} business app(s) registered: ${apps}")
    else()
        message(STATUS "fut: no business apps registered")
    endif()
endfunction()
