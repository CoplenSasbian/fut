{
  "host": "127.0.0.1",
  "port": 8080,
  "threads": 2,
  "apps_dir": "apps",
  "request_timeout_seconds": 30,
  "log_level": "info",

  "log": {
    "chains": [
      {
        "sink": "console",
        "level": "info",
        "formatter": "pattern",
        "pattern": "{T} [{L:<8}] {g:<12} {m}",
        "color": true
      },
      {
        "sink": "file",
        "level": "trace",
        "formatter": "pattern",
        "pattern": "{T} [{L:<8}] {g:<12} {s}: {m}",
        "path": "logs/fut.log",
        "max_bytes": 2097152,
        "max_files": 3
      }
    ]
  }
}
