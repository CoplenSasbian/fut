{
  "host": "127.0.0.1",
  "port": 8080,
  "threads": 2,
  "apps_dir": "apps",
  "request_timeout_seconds": 30,
  "log_level": "info",

  "log_pattern": "{T} [{L:<8}] {g:<12} {m}",
  "log_file_pattern": "{T} [{L:<8}] {g:<12} {s}: {m}",
  "log_file": "logs/fut.log",
  "log_file_max_bytes": 2097152,
  "log_file_max_files": 3
}
